# Ignore build artifacts
# The iOS app never deploys to Vercel, and its Xcode derived data alone is
# 40k+ files, which pushes a manual `vercel --prod` over the 15,000-file
# upload limit ("missing_archive").
ChoreStar-iOS/

# Ignore development files
.git/
.gitignore
*.md
quick-start.sh

# Ignore database files
*.sql

# Ignore deployment configs
deployment/

# Ignore email templates
email-templates/

# Ignore backend (not needed for frontend deployment)
backend/

# Ignore environment files
.env* 