# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production builds
build/
dist/

# Environment variables
.env
.env.*
!.env.local.example
.env.local
.env.production
.env.test
*.backup

# Configuration with secrets
setup-env.sh
.claude/

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Salesforce CLI / IDE cache (stray tooling — not part of this project)
.sfdx/
.sf/
.localdevserver/

# Admin analysis output (contains user emails)
chorestar-nextjs/scripts/output/

# User-data exports (PII — never commit)
/all-users-emails.txt
/chorestar-emails.csv
/chorestar-users.csv
/chorestar-users.json

# Logs
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Temporary files
tmp/
temp/
.vercel

# fastlane — credentials and run artifacts.
# Patterns need **/ : a slash anywhere in a pattern anchors it to THIS file's
# directory, so a bare fastlane/... would miss ChoreStar-iOS/fastlane/...
**/AuthKey_*.p8
*.p8
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/test_output/
# Staged copies of appstore-screenshots/, which is the committed source of truth.
**/fastlane/screenshots/
# `deliver download_metadata` writes the Apple-review demo login here. This repo
# is PUBLIC — these are real credentials and must never be committed.
**/fastlane/metadata/review_information/

# Xcode per-user UI state — churns on every launch, means nothing to a build
**/xcuserdata/

# Minted App Store Connect JWTs — short-lived credentials, never commit
asc.jwt
*.jwt
