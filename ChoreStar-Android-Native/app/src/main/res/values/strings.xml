<?xml version="1.0" encoding="utf-8"?>
<!--
  App-level names for every string the native UI shows.

  Where the iOS catalog (strings_shared.xml, generated from Localizable.xcstrings)
  already has the phrase, the entry here is an alias to that key so the iOS
  translations flow through untouched. Only phrases iOS does not have are
  written out in English here; translate those in values-<locale>/strings.xml.
-->
