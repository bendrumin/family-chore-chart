        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Pedido! Un adulto dirá que sí o que no a %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedido! Um adulto vai dizer sim ou não para %@."
          }
        }
