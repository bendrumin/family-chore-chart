    "One kid each week, switching every Sunday. Each kid keeps what they earn on their turn." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طفل واحد كل أسبوع، ويتغيّر كل يوم أحد. يحتفظ كل طفل بما يكسبه في دوره."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un niño cada semana, cambia cada domingo. Cada niño se queda con lo que gana en su turno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma criança por semana, trocando todo domingo. Cada criança fica com o que ganha na sua vez."
          }
        }
      }
    },
    "Every kid you pick sees it; the first to finish it that day earns the reward." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يراها كل طفل تختاره، وأول من ينجزها في ذلك اليوم يربح المكافأة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los niños que elijas la ven; el primero en terminarla ese día gana el premio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as crianças escolhidas veem; quem terminar primeiro no dia ganha a recompensa."
          }
        }
      }
    },
    "Rotate a chore between kids, or post a bonus chore the fastest kid earns." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدّل مهمة بين الأطفال، أو انشر مهمة مكافأة يربحها الأسرع."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rota una tarea entre niños o publica una tarea de bono para el más rápido."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reveze uma tarefa entre as crianças ou crie uma tarefa bônus para a mais rápida."
          }
        }
      }
    },
    "%@ (first)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (أولًا)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (primero)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (primeiro)"
          }
        }
      }
    },
    "Pick at least one more kid to share with." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر طفلًا آخر واحدًا على الأقل للمشاركة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige al menos otro niño para compartir."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha pelo menos mais uma criança para compartilhar."
          }
        }
      }
    },
    "Couldn't reach ChoreStar. Check your connection and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى ChoreStar. تحقّق من اتصالك وحاول مرة أخرى."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con ChoreStar. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar o ChoreStar. Verifique sua conexão e tente novamente."
          }
        }
      }
    },
    "Weekly Report Email" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البريد الأسبوعي للتقرير"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informe semanal por correo"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relatório semanal por e-mail"
          }
        }
      }
    },
    "Activity alerts buzz when a kid finishes all chores or a routine. The weekly report emails you each kid's week every Sunday. The daily reminder is a local nudge on this device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنبّهك إشعارات النشاط عندما ينهي طفل كل مهامه أو روتينًا. يرسل لك التقرير الأسبوعي أسبوع كل طفل يوم الأحد. التذكير اليومي تنبيه محلي على هذا الجهاز."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las alertas de actividad avisan cuando un niño termina todas sus tareas o una rutina. El informe semanal te envía la semana de cada niño cada domingo. El recordatorio diario es un aviso local en este dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os alertas de atividade avisam quando uma criança termina todas as tarefas ou uma rotina. O relatório semanal envia a semana de cada criança todo domingo. O lembrete diário é um aviso local neste aparelho."
          }
        }
      }
    },
    "Someone beat you to it today!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سبقك أحدهم إليها اليوم!"
