    "Each child earns %@ for finishing all of their chores today." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكسب كل طفل %@ عند إنهاء جميع مهامه اليوم."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada niño gana %@ por terminar todas sus tareas de hoy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada criança ganha %@ por concluir todas as tarefas de hoje."
          }
        }
      }
    },
    "Each chore gets its own reward, so bigger jobs can be worth more. You set the amount when you add a chore." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لكل مهمة مكافأتها الخاصة، فالأعمال الأكبر تستحق أكثر. تحدد المبلغ عند إضافة المهمة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada tarea tiene su propia recompensa, así los trabajos grandes valen más. Fijas el monto al agregar la tarea."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada tarefa tem sua própria recompensa, então trabalhos maiores valem mais. Você define o valor ao adicionar a tarefa."
          }
        }
      }
    },
