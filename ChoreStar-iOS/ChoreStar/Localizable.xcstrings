    "Your family now has unlimited children, chores, rewards and goals, plus family sharing, full stats and premium themes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصبح لدى عائلتك الآن عدد غير محدود من الأطفال والمهام والمكافآت والأهداف، بالإضافة إلى مشاركة العائلة والإحصائيات الكاملة والسمات المميزة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu familia ahora tiene hijos, tareas, recompensas y metas ilimitados, además de familia compartida, estadísticas completas y temas Premium."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua família agora tem filhos, tarefas, recompensas e metas ilimitados, além de família compartilhada, estatísticas completas e temas Premium."
