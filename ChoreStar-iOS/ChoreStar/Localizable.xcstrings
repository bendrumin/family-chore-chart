    "Only %@ available. Lower the amount, or allow going below zero." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المتاح %@ فقط. خفّض المبلغ، أو اسمح بالنزول تحت الصفر."
          }
        },
        "es" : {
          "stringUnit" : {
