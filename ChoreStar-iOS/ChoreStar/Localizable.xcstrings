    "Paid automatically on payday in your family's time zone. Next payday: %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُدفع تلقائيًا في يوم الدفع حسب المنطقة الزمنية لعائلتك. يوم الدفع القادم: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se paga solo el día de pago, en la zona horaria de tu familia. Próximo día de pago: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pago automaticamente no dia do pagamento, no fuso horário da sua família. Próximo pagamento: %@."
          }
