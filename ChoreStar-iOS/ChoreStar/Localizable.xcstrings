    "80" : {
      "shouldTranslate" : false
    },
    "A calm bar for the whole routine. No fail state; finishing early is celebrated." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شريط هادئ للروتين كله. لا يوجد فشل، والانتهاء مبكرًا يُحتفل به."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una barra tranquila para toda la rutina. Nadie pierde; terminar antes se celebra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma barra tranquila para a rotina toda. Ninguém perde; terminar antes é comemorado."
          }
        }
      }
    },
    "A challenge can run up to 93 days" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أن يستمر التحدي حتى 93 يومًا"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un reto puede durar hasta 93 días"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um desafio pode durar até 93 dias"
          }
        }
      }
    },
    "A kid" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طفل"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un niño"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma criança"
          }
        }
      }
    },
    "A second reward next to money. Chores and routines with minutes add to %@'s bank when they're done; you mark minutes used. ChoreStar doesn't lock any device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مكافأة ثانية بجانب المال. المهام والروتينات ذات الدقائق تُضاف إلى رصيد %@ عند إنجازها، وأنت تسجّل الدقائق المستخدمة. لا يقفل ChoreStar أي جهاز."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una segunda recompensa además del dinero. Las tareas y rutinas con minutos suman al banco de %@ al terminarlas; tú marcas los minutos usados. ChoreStar no bloquea ningún dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma segunda recompensa além do dinheiro. Tarefas e rotinas com minutos somam ao banco de %@ quando são feitas; você marca os minutos usados. O ChoreStar não bloqueia nenhum aparelho."
          }
        }
      }
    },
    "A small weekly % so saving visibly pays." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسبة أسبوعية صغيرة ليظهر أن الادخار مفيد."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pequeño % semanal para que ahorrar se note."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um pequeno % semanal para que poupar valha a pena."
          }
        }
      }
    },
    "Add a child first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
