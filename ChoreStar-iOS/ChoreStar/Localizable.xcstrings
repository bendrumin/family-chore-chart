    "Comes out of %@ (%@ now). Never below zero unless you allow it. %@ sees every one with its reason." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُخصم من %1$@ (%2$@ الآن). لا ينزل تحت الصفر إلا إذا سمحت. يرى %3$@ كل خصم مع سببه."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sale de %1$@ (%2$@ ahora). Nunca por debajo de cero, salvo que lo permitas. %3$@ ve cada uno con su motivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sai de %1$@ (%2$@ agora). Nunca abaixo de zero, a menos que você permita. %3$@ vê cada um com o motivo."
          }
        }
      }
    },
