    "New co-parents can't join on the free plan. Get a new code or turn this one off so an old code can't be reused." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لوالد مشارك جديد الانضمام على الخطة المجانية. أنشئ رمزًا جديدًا أو أوقف هذا الرمز حتى لا يُعاد استخدام رمز قديم."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el plan gratis no pueden unirse nuevos adultos. Crea un código nuevo o desactiva este para que no se pueda volver a usar uno viejo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No plano grátis, novos responsáveis não podem entrar. Crie um código novo ou desative este para que um código antigo não seja reutilizado."
          }
        }
      }
    },
    "Turn off this invite code?" : {
