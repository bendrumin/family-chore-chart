    "Spend, Save and Give jars, a weekly allowance, interest on savings, fines and paybacks, and screen-time minutes. Each kid gets their own settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حصالات للصرف والادخار والعطاء، ومصروف أسبوعي، وفائدة على المدخرات، وغرامات وسداد، ودقائق شاشة. لكل طفل إعداداته الخاصة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frascos para Gastar, Ahorrar y Dar, mesada semanal, interés por ahorrar, multas y devoluciones, y minutos de pantalla. Cada niño tiene su propia configuración."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potes para Gastar, Poupar e Doar, mesada semanal, juros da poupança, multas e devoluções, e minutos de tela. Cada criança tem suas próprias configurações."
          }
        }
      }
    },
