    "Amazing job! You're a superstar!": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عمل مذهل! أنت نجم لامع!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Increíble! ¡Eres una superestrella!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incrível! Você é uma superestrela!"
          }
        }
      }
    },
    "Ask a grown-up to pay it out and pick your next goal!": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب من شخص كبير أن يدفع لك المبلغ واختر هدفك التالي!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Pídele a un adulto que te lo pague y elige tu próxima meta!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça para um adulto pagar e escolha sua próxima meta!"
          }
        }
      }
    },
    "Ask a parent for your family code": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب رمز العائلة من ماما أو بابا"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pídele a papá o mamá el código de tu familia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça o código da família para o papai ou a mamãe"
          }
        }
      }
    },
