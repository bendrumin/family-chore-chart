    },
    "Your family's chore data is erased from our servers and can't be recovered. There's no way to undo this." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُمحى بيانات مهام عائلتك من خوادمنا ولا يمكن استعادتها. لا يمكن التراجع عن ذلك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de tareas de tu familia se borran de nuestros servidores y no se pueden recuperar. No hay forma de deshacerlo."
