    "%@ owes you %@. It gets paid back as %@ earns." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على %1$@ لك %2$@. يُسدَّد مما يكسبه %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ te debe %2$@. Se paga a medida que %3$@ gane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ deve %2$@ a você. Será pago conforme %3$@ ganhar."
          }
        }
      }
    },
