    "\"Phone bill, $2 a week.\" Never below zero unless you say so." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"فاتورة الهاتف، 2$ أسبوعيًا.\" لا ينزل الرصيد تحت الصفر إلا إذا سمحت بذلك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Factura del teléfono, $2 a la semana.\" Nunca por debajo de cero, salvo que tú lo digas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Conta do celular, $2 por semana.\" Nunca abaixo de zero, a menos que você permita."
          }
        }
      }
    },
    "% of chores in the week before payday" : {
