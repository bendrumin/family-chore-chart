<?xml version="1.0" encoding="utf-8"?>
<!--
  Long-press the launcher icon. Both shortcuts open a chorestar.app URL the app
  already claims as an App Link, so the shell's own bridge routes them: warm
  starts follow appUrlOpen, cold starts follow the launch URL.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="kid-mode"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_kid"
        android:shortcutShortLabel="@string/shortcut_kid_short"
        android:shortcutLongLabel="@string/shortcut_kid_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.chorestar.app"
            android:targetClass="com.chorestar.app.MainActivity"
            android:data="https://chorestar.app/kid-login"/>
        <categories android:name="android.shortcut.conversation"/>
    </shortcut>
    <shortcut
        android:shortcutId="today"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_home"
        android:shortcutShortLabel="@string/shortcut_today_short"
        android:shortcutLongLabel="@string/shortcut_today_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.chorestar.app"
            android:targetClass="com.chorestar.app.MainActivity"
            android:data="https://chorestar.app/dashboard"/>
        <categories android:name="android.shortcut.conversation"/>
    </shortcut>
</shortcuts>
